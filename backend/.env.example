# Optional credentials for background scheduled syncing.
# Normally, sign in through the dashboard instead.
MYTNB_USERNAME=
MYTNB_PASSWORD=

# App settings
DATABASE_URL=sqlite+aiosqlite:///./mytnb.db
POLL_INTERVAL_HOURS=6
CORS_ORIGINS=http://localhost:3000

# Optional: API key to protect your endpoints
API_SECRET_KEY=change-me-to-a-random-string
